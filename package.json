{
	"name": ".",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000",
		"frontend": "vite --port 3000",
		"start": "vite --port 3000",
		"build": "vite build && pnpm typecheck",
		"typecheck": "tsc --project tsconfig.json",
		"serve": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:editor": "node verification/editor-smoke.mjs",
		"format": "oxfmt --write .",
		"lint": "oxlint --deny-warnings .",
		"check": "pnpm format:check && pnpm lint",
		"doctor": "react-doctor",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"verify:checks": "pnpm check && pnpm test && pnpm build && pnpm --filter yaffw-landing verify",
		"verify": "pnpm verify:checks && pnpm test:editor"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/router-plugin": "^1.168.23",
		"@videojs/react": "10.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"lucide-react": "^0.476.0",
		"mediabunny": "1.65.2",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-resizable-panels": "^4.19.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"wavesurfer.js": "^7.12.11"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/culori": "^4.0.1",
		"@types/node": "24.19.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-istanbul": "5.0.5",
		"canvas": "3.2.3",
		"jsdom": "30.1.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"playwright": "1.65.0",
		"react-doctor": "0.9.18",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
