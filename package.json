{
	"name": ".",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000",
		"frontend": "vite --port 3000",
		"start": "vite --port 3000",
		"build": "vite build && pnpm typecheck",
		"typecheck": "tsc --project tsconfig.json",
		"serve": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "oxfmt --write .",
		"lint": "oxlint --deny-warnings .",
		"check": "pnpm format:check && pnpm lint",
		"doctor": "react-doctor",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"verify": "pnpm check && pnpm test && pnpm build"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/router-plugin": "^1.168.23",
		"@types/node": "^24.13.3",
		"@vidstack/react": "1.15.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"lucide-react": "^0.476.0",
		"mediabunny": "1.65.2",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-resizable-panels": "^4.19.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"wavesurfer.js": "^7.12.11"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/culori": "^4.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-istanbul": "3.2.7",
		"jsdom": "^26.0.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"react-doctor": "^0.6.3",
		"typescript": "7.0.2",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=24"
	}
}
