{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"ignore": [
			"src/routeTree.gen.ts",
			"**/node_modules/**",
			"**/dist/**",
			".tanstack/**",
			"tmp/**",
			"coverage/**",
			"docs/**",
			"public/**",
			".git/**",
			"prototypes/nle/media/**"
		],
		"include": [
			"src/**",
			"prototypes/nle/*.ts",
			"prototypes/nle/*.tsx",
			"prototypes/nle/*.json",
			"verification/**/*.ts",
			"verification/**/*.mjs",
			"verification/**/*.cjs",
			"verification/**/biome.json",
			"verification/**/tsconfig.json",
			"vite.config.ts",
			"index.html",
			".vscode/*.json",
			"biome.json",
			"package.json",
			"components.json",
			"tsconfig.json",
			"tsconfig.editor-next.json",
			"wrangler.jsonc"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
