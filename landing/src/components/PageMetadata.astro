---
import { EDITOR_URL, REPO_URL } from "../links.js";

interface Props {
	title: string;
	description: string;
	ogDescription?: string;
	canonical?: URL;
}

const {
	title,
	description,
	ogDescription = description,
	canonical,
} = Astro.props;
const imageUrl = canonical
	? new URL("/og.png", canonical.origin).href
	: undefined;
const imageAlt = "YAFFW — Edit video in your browser. No uploads. No account.";
const home = canonical ? new URL("/", canonical).href : undefined;
const applicationId = home ? `${home}#application` : undefined;
const structuredData =
	canonical && home
		? {
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "WebPage",
						"@id": `${canonical.href}#webpage`,
						url: canonical.href,
						name: title,
						description,
						inLanguage: "en",
						isPartOf: { "@id": `${home}#website` },
						about: { "@id": applicationId },
					},
					// The home page owns the site/application entities; other pages link to them.
					...(canonical.pathname === "/"
						? [
								{
									"@type": "WebSite",
									"@id": `${home}#website`,
									url: home,
									name: "YAFFW",
									inLanguage: "en",
								},
								{
									"@type": "WebApplication",
									"@id": applicationId,
									name: "YAFFW",
									url: EDITOR_URL,
									description,
									applicationCategory: "MultimediaApplication",
									browserRequirements:
										"Requires WebCodecs support, such as Chrome or Edge. Codec support depends on the browser.",
									isAccessibleForFree: true,
									image: imageUrl,
									sameAs: REPO_URL,
								},
							]
						: []),
				],
			}
		: undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical ? (
	<>
		<meta name="robots" content="max-image-preview:large" />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="YAFFW" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
		/>
	</>
) : (
	<meta name="robots" content="noindex,follow" />
)}
