---
import { Picture } from "astro:assets";
import workbench from "../assets/workbench-current.jpg";
interface Props {
	detail?: boolean;
}
const { detail = false } = Astro.props;
---

<Picture
	src={workbench}
	widths={[480, 640, 800, 1200, 1400, 1600]}
	formats={["avif", "webp"]}
	fallbackFormat="jpg"
	quality={85}
	sizes={
		detail
			? "(max-width: 767px) 780px, (max-width: 1279px) calc(100vw - 80px), 1160px"
			: "(max-width: 767px) calc(100vw - 48px), (max-width: 1279px) calc(100vw - 80px), 1160px"
	}
	priority={!detail}
	loading={detail ? "lazy" : "eager"}
	alt={
		detail
			? "Selection timeline in the real YAFFW editor, with video thumbnails, an audio waveform, zoom, and a playhead."
			: "The YAFFW workbench: video preview, output settings with a Start export button, a transport bar, and a selection timeline with thumbnails and a waveform."
	}
/>
