---
import "../styles/index.css";
import PageMetadata from "../components/PageMetadata.astro";
import { EDITOR_URL, REPO_URL } from "../links.js";

interface Props {
	title: string;
	description: string;
	/** Social preview text, when it should differ from the meta description. */
	ogDescription?: string;
	/** Only content pages declare a stable canonical path. */
	canonicalPath?: "/" | "/changelog/";
}

const {
	title,
	description,
	ogDescription = description,
	canonicalPath,
} = Astro.props;
const canonical =
	Astro.site && canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
const path = Astro.url.pathname;
const sections = [
	["demo", "Selection"],
	["local", "Local-first"],
	["features", "Features"],
	["shortcuts", "Shortcuts"],
	["source", "Source"],
];
---

<!doctype html>
<html lang="en" class="workbench">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<PageMetadata {title} {description} {ogDescription} {canonical} />
		<meta name="theme-color" content="oklch(1 0 none)" />
		<meta name="color-scheme" content="light" />
		<link rel="icon" href="/assets/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/assets/apple-touch-icon.png"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=Geist+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>

		<header class="nav" data-nav>
			<div class="nav__inner">
				<a class="brand" href="/" aria-label="YAFFW home">
					<img src="/assets/icon-192.png" alt="" width="24" height="24" />
					<span>YAFFW</span>
				</a>
				<nav class="nav__links" aria-label="Primary">
					<div class="nav__sections">
						{sections.map(([id, label]) => (
							<a href={`/#${id}`}>{label}</a>
						))}
					</div>

					<a
						href="/changelog/"
						aria-current={path.startsWith("/changelog") ? "page" : undefined}
					>
						Changelog
					</a>
				</nav>
				<div class="nav__actions">
					<a class="icon-link" href={REPO_URL} aria-label="YAFFW on GitHub">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
							></path>
						</svg>
					</a>
					<a class="btn btn--primary btn--sm" href={EDITOR_URL}>
						Open editor
					</a>
				</div>
				<nav class="nav__compact" aria-label="Primary">
					<details class="nav__menu" data-section-menu>
						<summary aria-label="Menu">
							<svg
								viewBox="0 0 24 24"
								width="20"
								height="20"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<path d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
						</summary>
						<div class="nav__menu-links">
							{sections.map(([id, label]) => (
								<a href={`/#${id}`}>{label}</a>
							))}
							<a
								href="/changelog/"
								aria-current={
									path.startsWith("/changelog") ? "page" : undefined
								}
							>
								Changelog
							</a>
						</div>
					</details>
				</nav>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="footer">
			<div class="container footer__inner">
				<div class="footer__brand">
					<a class="brand" href="/">
						<img src="/assets/icon-192.png" alt="" width="20" height="20" />
						<span>YAFFW</span>
					</a>
					<p>A personal, opinionated video editor for the browser.</p>
				</div>
				<div class="footer__cols">
					<div>
						<h2>Product</h2>
						<a href={EDITOR_URL}>Editor</a>
						<a href="/#features">Features</a>
						<a href="/#shortcuts">Shortcuts</a>
						<a href="/#limits">Limitations</a>
						<a href="/changelog/">Changelog</a>
					</div>
					<div>
						<h2>Source</h2>
						<a href={REPO_URL}>GitHub</a>
						<a href={`${REPO_URL}#readme`}>README</a>
						<a href={`${REPO_URL}/issues`}>Issues</a>
					</div>
				</div>
			</div>
			<div class="container footer__base">
				<span class="mono dim">
					© 2026 YAFFW · Made by{" "}
					<a class="footer__credit" href="https://fuad.work/">
						fuad
					</a>
				</span>
			</div>
		</footer>

		<script>
			import "../scripts/nav.js";
		</script>
	</body>
</html>
