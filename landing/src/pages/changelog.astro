---
import Base from "../layouts/Base.astro";
import { loadReleases } from "../releases";

const RELEASES_URL = "https://github.com/DarkZeus/yaffw/releases";
const releases = await loadReleases();
const date = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base title="Changelog · YAFFW" description="Every published YAFFW release, newest first.">
	<section class="changelog container">
		<header class="changelog__head">
			<h1 class="changelog__title">Changelog</h1>
			<a class="btn btn--ghost btn--sm" href={RELEASES_URL}>Releases on GitHub</a>
		</header>

		{
			releases.length === 0 ? (
				<div class="changelog__empty">
					<p>No releases yet.</p>
					<p class="dim">Each release published on GitHub appears here.</p>
				</div>
			) : (
				<ol class="releases">
					{releases.map((r) => (
						<li class="release" id={r.tag_name}>
							<div class="release__meta">
								<time datetime={r.published_at}>{date.format(new Date(r.published_at))}</time>
								<a class="release__tag mono" href={r.html_url}>
									{r.tag_name}
								</a>
								{r.prerelease && <span class="release__pre">Pre-release</span>}
							</div>
							<div class="release__body">
								<h2 class="release__name">{r.name || r.tag_name}</h2>
								{r.body_html && <div class="prose" set:html={r.body_html} />}
							</div>
						</li>
					))}
				</ol>
			)
		}
	</section>
</Base>
