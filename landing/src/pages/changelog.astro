---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("changelog")).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const date = new Intl.DateTimeFormat("en", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
const rendered = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		Content: (await render(entry)).Content,
	})),
);
---

<Base
	title="Changelog · YAFFW"
	description="Notable changes to the YAFFW editor, newest first."
>
	<section class="changelog container">
		<header class="changelog__head">
			<h1 class="changelog__title">Changelog</h1>
		</header>

		{rendered.length === 0 ? (
			<div class="changelog__empty">
				<p>No entries yet.</p>
			</div>
		) : (
			<ol class="releases">
				{rendered.map(({ entry, Content }) => (
					<li class="release" id={entry.id}>
						<div class="release__meta">
							<time datetime={entry.data.date.toISOString().slice(0, 10)}>
								{date.format(entry.data.date)}
							</time>
							{entry.data.version && (
								<span class="release__tag mono">{entry.data.version}</span>
							)}
						</div>
						<div class="release__body">
							<h2 class="release__name">
								<a href={`#${entry.id}`}>{entry.data.title}</a>
							</h2>
							<div class="prose">
								<Content />
							</div>
						</div>
					</li>
				))}
			</ol>
		)}
	</section>
</Base>
