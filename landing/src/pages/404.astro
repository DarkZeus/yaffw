---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · YAFFW" description="This page doesn't exist.">
	<section class="changelog container">
		<header class="changelog__head">
			<h1 class="changelog__title">Page not found</h1>
		</header>
		<div class="changelog__empty">
			<p>This address doesn't match a page.</p>
			<p><a class="btn btn--ghost btn--sm" href="/">Go to the home page</a></p>
		</div>
	</section>
</Base>
