---
import Base from "../layouts/Base.astro";
import WorkbenchScreenshot from "../components/WorkbenchScreenshot.astro";
import { EDITOR_URL, REPO_URL } from "../links.js";
import { timelineHTML, sceneAt } from "../scripts/timeline.js";
---

<Base
	title="YAFFW: edit local video in your browser"
	description="YAFFW is a video editor that runs in a browser tab. Open a local video, keep the part you want, adjust the audio, and export. Your video is never uploaded."
	ogDescription="Cut, mix and export video without uploading it. Runs entirely in your browser."
>
	<!-- ───────────────────────────── Hero ───────────────────────────── -->
	<section class="hero" id="top" tabindex="-1" data-scroll-target>
		<div class="hero__copy">
			<h1 class="hero__title reveal" style="--d: 1">Cut video without uploading it</h1>
			<p class="hero__lead reveal" style="--d: 2">
				A focused workbench for one local video at a time. Inspect, mix and export on your device.
			</p>
			<div class="hero__ctas reveal" style="--d: 3">
				<a class="btn btn--primary btn--lg" href={EDITOR_URL}>
					Open the editor
					<kbd class="btn__kbd" aria-hidden="true">↵</kbd>
				</a>
				<a class="btn btn--ghost btn--lg" href={REPO_URL}>View source</a>
			</div>
			<p class="hero__meta reveal" style="--d: 4">Works in Chrome and Edge</p>
		</div>
		<div class="hero__shot reveal" style="--d: 3">
			<WorkbenchScreenshot />
		</div>
	</section>

	<!-- ───────────────────────────── Demo ───────────────────────────── -->
	<section class="section" id="demo" tabindex="-1" data-scroll-target>
		<div class="container">
			<header class="section__head">
				<h2 class="section__title" data-reveal>Keep the part you want</h2>
				<ol class="workflow">
					<li><b>Open a video</b><p>Drop a file into the editor or use the picker. Media shows its details and tracks.</p></li>
					<li><b>Choose what to keep</b><p>Drag the Selection, preview the range, and choose which audio tracks contribute to the export.</p></li>
					<li><b>Review and download</b><p>Choose format and quality, Apply settings, review the plan, then export and download the result.</p></li>
				</ol>
			</header>
			<div class="demo" data-demo tabindex="-1">
				<div class="demo__top">
					<div class="demo__viewer" data-viewer style={`background: ${sceneAt(0)}`}>
						<div class="demo__osd mono"><span>1×</span><output data-out="timecode">00:00:00.000</output></div>
					</div>
					<aside class="demo__out">
						<h3>Output</h3>
						<dl>
							<div><dt>Format</dt><dd>MP4 / H.264 / AAC</dd></div>
							<div><dt>Range</dt><dd class="mono"><output data-out="start" data-short>00:00.000</output> – <output data-out="end" data-short>01:33.525</output></dd></div>
							<div><dt>Length</dt><dd class="mono"><output data-out="duration" data-short>01:33.525</output></dd></div>
						</dl>
						<a class="btn btn--primary demo__export" href={EDITOR_URL}>Start export in the editor</a>
					</aside>
				</div>
				<p class="enhancement-note">Static demo. Interactive controls require JavaScript.</p>
				<div class="transport">
					<div class="transport__group">
						<button class="t-btn t-btn--play" type="button" disabled data-play aria-label="Play"><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7-4.5z" fill="currentColor"/></svg><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z" fill="currentColor"/></svg></button>
						<button class="t-btn" type="button" disabled data-seek="-10" aria-label="Back 10 seconds"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 4L4 8l4 4M12 4L8 8l4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
						<button class="t-btn" type="button" disabled data-step="-1" aria-label="Previous frame"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3.5v9M12 4L7 8l5 4z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
						<button class="t-btn" type="button" disabled data-step="1" aria-label="Next frame"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3.5v9M4 4l5 4-5 4z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
						<button class="t-btn" type="button" disabled data-seek="10" aria-label="Forward 10 seconds"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l4 4-4 4M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
						<button class="t-btn" type="button" disabled data-loop aria-pressed="false" aria-label="Loop selection"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 7V6a2 2 0 0 1 2-2h7l-2-2M13 9v1a2 2 0 0 1-2 2H4l2 2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
					</div>
					<output class="timecode mono" data-out="timecode">00:00:00.000</output>
				</div>
				<div class="demo__tl">
					<div class="demo__labels" aria-hidden="true">
						<div></div>
						<div>Video</div>
						<div>Audio 1<small class="mono">AAC / 2 ch</small></div>
					</div>
					<Fragment set:html={timelineHTML()} />
				</div>
			</div>
			<p class="footnote">The selection starts as the whole file, so you can also use YAFFW to change a file's format or audio without cutting it.</p>
		</div>
	</section>

	<!-- ───────────────────────────── Local ───────────────────────────── -->
	<section class="section" id="local" tabindex="-1" data-scroll-target>
		<div class="container">
			<p class="local__num" data-reveal><span class="mono">0</span> bytes uploaded</p>
			<h2 class="local__title" data-reveal>
				Your footage stays on your machine. Decoding, mixing and encoding run in the tab with
				WebCodecs
			</h2>
			<div class="bound" data-bound>
				<div class="bound__web">
					<span class="bound__tag">The web</span>
					<div class="bound__node"><b>yaffw…workers.dev</b><span>Sends the editor's code once</span></div>
				</div>
				<div class="bound__line" aria-hidden="true"><i class="bound__code"></i></div>
				<div class="bound__pc">
					<span class="bound__tag">Your computer</span>
					<div class="bound__row">
						<div class="bound__node"><b class="mono">trip-2026.mov</b><span>On your disk</span></div>
						<div class="bound__wire bound__wire--in" aria-hidden="true"><i></i></div>
						<div class="bound__node bound__node--tab">
							<img src="/assets/icon-192.png" alt="" width="28" height="28" />
							<b>Browser tab</b><span>Decode, select, mix, encode</span>
						</div>
						<div class="bound__wire bound__wire--out" aria-hidden="true"><i></i></div>
						<div class="bound__node bound__node--out"><b class="mono">trip-2026-cut.mp4</b><span>In your downloads</span></div>
					</div>
				</div>
			</div>
			<ul class="local__facts">
				<li><b>No upload server</b><span>The file is read from your disk by the tab.</span></li>
				<li><b>No server fallback</b><span>Codecs your browser can't handle aren't sent to a server to convert.</span></li>
				<li><b>No account</b><span>No sign-in, API keys or backend services.</span></li>
			</ul>
		</div>
	</section>

	<!-- ───────────────────────────── Bento ───────────────────────────── -->
	<section class="section" id="features" tabindex="-1" data-scroll-target>
		<div class="container">
			<header class="section__head">
				<h2 class="section__title" data-reveal>
					The editor workbench
				</h2>
			</header>

			<div class="bento">
				<!-- Audio -->
				<article class="card card--wide card--audio">
					<div class="card__copy">
						<h3>Adjust audio</h3>
						<p>
							Include or exclude embedded audio tracks, set their volume, fix one-sided stereo
							recordings, and monitor each track or the combined output.
						</p>
					</div>
					<div class="mixer" aria-hidden="true">
						<div class="strip">
							<div class="strip__head"><b>Audio 1</b><small>AAC / 2 ch</small></div>
							<div class="strip__body">
								<div class="fader"><i style="--v: 0.82"></i></div>
								<div class="meter" data-meter="0.9"><i></i><i></i></div>
							</div>
							<div class="strip__foot"><span class="chip-sm">Keep as recorded</span></div>
						</div>
						<div class="strip">
							<div class="strip__head"><b>Audio 2</b><small>Opus / 1 ch</small></div>
							<div class="strip__body">
								<div class="fader"><i style="--v: 0.55"></i></div>
								<div class="meter" data-meter="0.6"><i></i><i></i></div>
							</div>
							<div class="strip__foot"><span class="chip-sm chip-sm--on">Auto-fix quiet side</span></div>
						</div>
						<div class="strip strip--master">
							<div class="strip__head"><b>Master</b><small>Monitored output</small></div>
							<div class="strip__body">
								<div class="meter meter--wide" data-meter="1"><i></i><i></i></div>
								<div class="meter-scale mono"><span>0</span><span>−20</span><span>−40</span><span>−60</span><span>−90</span></div>
							</div>
							<div class="strip__foot"><span class="chip-sm">1 output track</span></div>
						</div>
					</div>
				</article>

				<!-- Formats -->
				<article class="card card--formats">
					<div class="card__copy">
						<h3>Output formats</h3>
						<p>Choose compatible codecs. Export support depends on your browser.</p>
					</div>
					<div class="formats" data-formats aria-hidden="true">
						<div class="formats__row">
							<span>MP4</span><span>MOV</span><span>MKV</span><span>WebM</span><span>MPEG-TS</span>
						</div>
						<div class="formats__spec mono">
							<div><em>video</em><b data-spec-v>H.264</b></div>
							<div><em>audio</em><b data-spec-a>AAC</b></div>
							<div><em>size</em><b>Source · 3840×2160</b></div>
						</div>
					</div>
				</article>

				<!-- Layout -->
				<article class="card card--layout">
					<div class="card__copy">
						<h3>Arrange the workbench</h3>
						<p>
							Resize panels, or hold <kbd>⌥</kbd> and drag one into a split or tab group. YAFFW
							remembers your layout.
						</p>
					</div>
					<div class="layout-demo" aria-hidden="true">
						<div class="pane pane--a">Preview</div>
						<div class="pane pane--b">Export</div>
						<div class="pane pane--c">Transport</div>
						<div class="pane pane--d">Audio</div>
						<div class="pane pane--e">Selection</div>
					</div>
				</article>

				<!-- Presets -->
				<article class="card card--presets">
					<div class="card__copy">
						<h3>Export presets</h3>
						<p>Save presets in your browser. Last used settings recalls the settings you last successfully applied; choose Apply after loading.</p>
					</div>
					<ul class="presets" aria-hidden="true">
						<li class="is-active"><span>Last used settings</span><small class="mono">MP4 · H.264 · AAC</small></li>
						<li><span>720p MP4</span><small class="mono">MP4 · 1280×720 · 4 Mbps</small></li>
						<li><span>WebM, no audio</span><small class="mono">WebM · VP9</small></li>
					</ul>
				</article>

				<!-- Preview -->
				<article class="card card--preview">
					<div class="card__copy">
						<h3>Preview and inspect</h3>
						<p>Zoom the timeline, step frames, change speed, go fullscreen, then review the output.</p>
					</div>
					<div class="mini-viewer" aria-hidden="true" style={`background: ${sceneAt(7.003)}`}>
						<div class="mini-viewer__top mono"><span><i></i>1×</span><span>00:00:07.003</span></div>
						<svg class="mini-viewer__fs" viewBox="0 0 16 16"><path d="M10 2.5h3.5V6M6 13.5H2.5V10M13.5 2.5L9 7M2.5 13.5L7 9" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
					</div>
					<div class="speeds" aria-hidden="true">
						<span>0.25×</span><span>0.5×</span><span class="is-on">1×</span><span>1.5×</span><span>2×</span>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ───────────────────────────── Shortcuts ───────────────────────────── -->
	<section class="section" id="shortcuts" tabindex="-1" data-scroll-target>
		<div class="container">
			<details class="keyboard-disclosure" data-keyboard-disclosure>
				<summary><h2>Try keyboard controls</h2></summary>
				<div class="try">
					<div>
						<ul class="try__list">
							<li data-row="0"><span class="keycaps"><kbd class="cap cap--wide">Space</kbd><i>or</i><kbd class="cap">K</kbd></span><span>Play / pause</span></li>
							<li data-row="1"><span class="keycaps"><kbd class="cap">←</kbd><kbd class="cap">→</kbd></span><span>Seek one second</span></li>
							<li data-row="2"><span class="keycaps"><kbd class="cap">J</kbd><kbd class="cap">L</kbd></span><span>Seek ten seconds</span></li>
							<li data-row="3"><span class="keycaps"><kbd class="cap cap--wide">⇧ Shift</kbd><i>+</i><kbd class="cap">←</kbd><kbd class="cap">→</kbd></span><span>Step one frame</span></li>
							<li data-row="4"><span class="keycaps"><kbd class="cap">[</kbd><kbd class="cap">]</kbd></span><span>Set selection start / end at the playhead</span></li>
						</ul>
						<p class="try-note">Shortcuts pause while you're editing an input, using a dialog, or exporting.</p>
					</div>
					<div class="try__player" data-try tabindex="-1">
						<p class="enhancement-note">Static demo. Interactive controls require JavaScript.</p>
						<div class="try__time mono"><output data-out="timecode">00:00:00.000</output></div>
						<Fragment set:html={timelineHTML({ ruler: false, video: false })} />
						<div class="try__foot">
							<button class="t-btn t-btn--play" type="button" disabled data-play aria-label="Play"><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7-4.5z" fill="currentColor"/></svg><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z" fill="currentColor"/></svg></button>
							<button class="t-btn" type="button" disabled data-loop aria-pressed="false" aria-label="Loop selection"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 7V6a2 2 0 0 1 2-2h7l-2-2M13 9v1a2 2 0 0 1-2 2H4l2 2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
							<span class="mono try__range">Selection <output data-out="start" data-short>00:00.000</output> – <output data-out="end" data-short>01:33.525</output></span>
							<span class="try__hint" data-hint></span>
						</div>
					</div>
				</div>
			</details>
		</div>
	</section>

	<!-- ───────────────────────────── Limits ───────────────────────────── -->
	<section class="section" id="limits" tabindex="-1" data-scroll-target>
		<div class="container limits-grid">
			<div>
				<h2 class="limits__heading" data-reveal>Limitations</h2>
				<ul class="limits">
					<li><b>Chromium comes first</b><span>Needs WebCodecs support, such as Chrome or Edge.</span></li>
					<li><b>Export boundaries are best effort</b><span>Exported start and end frames may not land exactly on the selection.</span></li>
					<li><b>Large exports need memory</b><span>YAFFW buffers the output in memory before download.</span></li>
				</ul>
			</div>
			<div id="planned" tabindex="-1" data-scroll-target>
				<h2 class="limits__heading" data-reveal>Planned</h2>
				<ul class="limits">
					<li><b>Multiple videos and audio-only files</b><span>Today YAFFW opens one video at a time.</span></li>
					<li><b>Saving your edit across refreshes</b><span>Today a refresh clears the loaded video, selection and export result. YAFFW already remembers layout and presets.</span></li>
				</ul>
			</div>
		</div>
	</section>

	<!-- ───────────────────────────── Source ───────────────────────────── -->
	<section class="section" id="source" tabindex="-1" data-scroll-target>
		<div class="container source">
			<div>
				<h2 class="section__title" data-reveal>
					Run it locally
					<span class="muted">You need Node.js 24.15+ (or 26+) and pnpm 10.33.0. There are no API keys, environment variables or backend services to set up.</span>
				</h2>
				<a class="btn btn--ghost" href={REPO_URL}>DarkZeus/yaffw on GitHub →</a>
			</div>
			<article class="repo" data-repo>
				<header class="repo__head">
					<img src="/assets/icon-192.png" alt="" width="20" height="20" />
					<a href={REPO_URL}><span class="dim">DarkZeus /</span> <b>yaffw</b></a>
				</header>
				<p class="repo__desc">A video editor that runs in your browser, built around my own editing workflow.</p>
				<div class="repo__tabs" hidden role="tablist" aria-label="Commands">
					<button id="commands-run-tab" role="tab" aria-controls="commands-run-panel" aria-selected="true" tabindex="0" data-tab="0">Run</button>
					<button id="commands-develop-tab" role="tab" aria-controls="commands-develop-panel" aria-selected="false" tabindex="-1" data-tab="1">Develop</button>
				</div>
<pre id="commands-run-panel" class="repo__term mono" role="tabpanel" aria-labelledby="commands-run-tab" data-pane="0" tabindex="0"><code data-command>{`git clone ${REPO_URL}.git
cd yaffw
pnpm install --frozen-lockfile
pnpm dev`}</code>
<span class="t-o">  ➜  Local:   </span><span class="t-a">http://localhost:3000/</span></pre>
				<div id="commands-develop-panel" role="tabpanel" aria-labelledby="commands-develop-tab" tabindex="0" data-pane="1" hidden>
					<dl class="repo__dev mono">
						<div><dt>pnpm verify</dt><dd>Format, lint, test, build and type check</dd></div>
						<div><dt>pnpm test</dt><dd>Run the test suite</dd></div>
						<div><dt>pnpm typecheck</dt><dd>Check types with TypeScript 7</dd></div>
						<div><dt>pnpm run build</dt><dd>Build to dist</dd></div>
					</dl>
				</div>
				<button class="copy-btn repo__copy" type="button" hidden data-copy><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg><span data-label>Copy</span></button>
				<p class="repo__feedback" role="status" data-copy-status></p>
			</article>
			<div class="source__credits">
				<h3>Built with</h3>
				<p>Thanks to the open-source projects and browser media APIs that make local editing possible.</p>
				<dl class="source__technologies">
					<div><dt>Browser APIs</dt><dd><a href="https://developer.mozilla.org/en-US/docs/Web/API/WebCodecs_API">WebCodecs</a><a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API">Web Audio</a></dd></div>
					<div><dt>Libraries and frameworks</dt><dd><a href="https://mediabunny.dev/">Mediabunny</a><a href="https://wavesurfer.xyz/">wavesurfer.js</a><a href="https://react.dev/">React</a><a href="https://tailwindcss.com/">Tailwind CSS</a><a href="https://ui.shadcn.com/">shadcn/ui</a></dd></div>
					<div><dt>Editor tooling</dt><dd><a href="https://www.typescriptlang.org/">TypeScript</a><a href="https://vite.dev/">Vite</a></dd></div>
					<div><dt>Landing site</dt><dd><a href="https://astro.build/">Astro</a></dd></div>
				</dl>
			</div>
		</div>
	</section>

	<!-- ───────────────────────────── CTA ───────────────────────────── -->
	<section class="cta">
		<WorkbenchScreenshot background />
		<div class="container cta__inner">
			<img class="cta__icon" src="/assets/icon-512.png" alt="" width="112" height="112" />
			<h2>Try YAFFW</h2>
			<div class="hero__ctas">
				<a class="btn btn--primary btn--lg" href={EDITOR_URL}>Open the editor</a>
				<a class="btn btn--ghost btn--lg" href={`${REPO_URL}#readme`}>Read the README</a>
			</div>
		</div>
	</section>
</Base>

<script>
	import "../scripts/main.js";
</script>
