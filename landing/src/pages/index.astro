---
import { Image, Picture } from "astro:assets";
import brandIcon from "../../public/assets/icon-192.png";
import audioPanel from "../assets/audio-panel.jpg";
import exportPanel from "../assets/export-panel.jpg";
import SelectionExample from "../components/SelectionExample.astro";
import Base from "../layouts/Base.astro";
import WorkbenchScreenshot from "../components/WorkbenchScreenshot.astro";
import { EDITOR_URL, REPO_URL } from "../links.js";
import { timelineHTML } from "../scripts/timeline.js";
---

<Base
	canonicalPath="/"
	title="YAFFW: edit local video in your browser"
	description="YAFFW is a video editor that runs in a browser tab. Open a local video, keep the part you want, adjust the audio, and export. Your video is never uploaded."
	ogDescription="Cut, mix and export video without uploading it. Runs entirely in your browser."
>
	<section class="hero container" id="top" tabindex="-1" data-scroll-target>
		<div class="hero__copy">
			<h1 class="hero__title">
				Edit video in
				<br />
				your browser.
			</h1>
			<div class="hero__intro">
				<p class="hero__lead">
					Open a video, choose what to keep, adjust the audio, and export. Your
					file stays on your device.
				</p>
				<div class="hero__ctas">
					<a class="btn btn--primary btn--lg" href={EDITOR_URL}>
						Open the editor <span aria-hidden="true">↗</span>
					</a>
					<a class="text-link" href={REPO_URL}>
						View source
					</a>
				</div>
				<p class="hero__meta">Free. No account. Works in Chrome and Edge.</p>
			</div>
		</div>
		<figure class="hero__figure">
			<div class="hero__shot">
				<WorkbenchScreenshot />
			</div>
			<figcaption>
				<span>YAFFW · Local video editor</span>
				<span>Preview. Select. Export.</span>
			</figcaption>
		</figure>
	</section>

	<section class="section" id="demo" tabindex="-1" data-scroll-target>
		<div class="container">
			<header class="chapter-head">
				<p class="chapter-label">Selection</p>
				<div>
					<h2 class="section__title">Keep the part you want.</h2>
					<p class="chapter-lead">
						One video, from the first preview to the final export.
					</p>
				</div>
			</header>
			<ol class="workflow">
				<li>
					<span class="workflow__number" aria-hidden="true">
						01
					</span>
					<b>Open a video</b>
					<p>
						Drop a file into the editor or use the picker. Inspect its details
						and embedded tracks.
					</p>
				</li>
				<li>
					<span class="workflow__number" aria-hidden="true">
						02
					</span>
					<b>Choose what to keep</b>
					<p>
						Drag the Selection, zoom into the waveform, or step through the
						preview one frame at a time.
					</p>
				</li>
				<li>
					<span class="workflow__number" aria-hidden="true">
						03
					</span>
					<b>Review and download</b>
					<p>
						Choose format and quality, Apply settings, review the plan, then
						export and download the result.
					</p>
				</li>
			</ol>
			<div class="selection-detail">
				<WorkbenchScreenshot detail />
			</div>
			<p class="footnote">
				The selection starts as the whole file. You can also change a file’s
				format or audio without cutting it.
			</p>
			<SelectionExample />
		</div>
	</section>

	<section
		class="section local-section"
		id="local"
		tabindex="-1"
		data-scroll-target
	>
		<div class="container local">
			<div>
				<p class="chapter-label">Local-first</p>
				<h2 class="section__title">
					Your file stays
					<br />
					on your device.
				</h2>
				<p class="chapter-lead">
					Preview, audio mixing, and export happen in the browser. There is no
					video upload and no account to create.
				</p>
			</div>
			<div class="local__details">
				<div
					class="local__route"
					aria-label="Your video is read from disk, processed in the browser, then saved to your device."
				>
					<span>Your file</span>
					<span aria-hidden="true">→</span>
					<span>Browser tab</span>
					<span aria-hidden="true">→</span>
					<span>Your export</span>
				</div>
				<ul class="local__facts">
					<li>
						<b>No upload server</b>
						<span>The editor reads the file from your disk.</span>
					</li>
					<li>
						<b>Processing in the tab</b>
						<span>
							Decoding, mixing and encoding use browser media APIs, including
							WebCodecs.
						</span>
					</li>
					<li>
						<b>No server fallback</b>
						<span>
							If your browser cannot handle a codec, the file is not sent
							elsewhere to convert.
						</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="section" id="features" tabindex="-1" data-scroll-target>
		<div class="container">
			<header class="chapter-head">
				<p class="chapter-label">The workbench</p>
				<div>
					<h2 class="section__title">Control what goes out.</h2>
					<p class="chapter-lead">
						Adjust the audio and output settings before you export.
					</p>
				</div>
			</header>
			<div class="feature-pair">
				<article class="feature">
					<div class="feature__media feature__media--audio">
						<Picture
							src={audioPanel}
							widths={[280, 560, 840]}
							formats={["avif", "webp"]}
							loading="lazy"
							alt="YAFFW’s Audio panel, with track volume, stereo level meters, channel handling, and preview monitoring controls."
						/>
					</div>
					<h3>Adjust audio</h3>
					<p>
						Include or exclude embedded tracks, set their volume, and fix
						one-sided stereo recordings. Monitor a track or the combined output.
					</p>
				</article>
				<article class="feature">
					<div class="feature__media feature__media--export">
						<Picture
							src={exportPanel}
							widths={[400, 800]}
							formats={["avif", "webp"]}
							loading="lazy"
							alt="YAFFW’s Export panel showing the format, resolution, quality, selected range, output settings, and Start export action."
						/>
					</div>
					<h3>Choose your output</h3>
					<p>
						Set format, codecs, resolution, and quality. Apply your settings,
						then review the output before starting an export. Codec support
						depends on your browser.
					</p>
				</article>
			</div>
			<div class="feature-notes">
				<article>
					<h3>Arrange the workbench</h3>
					<p>
						Resize panels, or hold <kbd>⌥</kbd> and drag one into a split or tab
						group. YAFFW remembers your layout.
					</p>
				</article>
				<article>
					<h3>Save export presets</h3>
					<p>
						Keep presets in your browser. Last used settings recalls your last
						applied settings; choose Apply after loading.
					</p>
				</article>
				<article>
					<h3>Preview and inspect</h3>
					<p>
						Zoom the timeline, step frames, change preview speed, or go
						fullscreen. Preview volume and speed do not change the export.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ───────────────────────────── Shortcuts ───────────────────────────── -->
	<section class="section" id="shortcuts" tabindex="-1" data-scroll-target>
		<div class="container">
			<details class="keyboard-disclosure" data-keyboard-disclosure>
				<summary>
					<h2>Try keyboard controls</h2>
				</summary>
				<div class="try">
					<div>
						<ul class="try__list">
							<li data-row="0">
								<span class="keycaps">
									<kbd class="cap cap--wide">Space</kbd>
									<i>or</i>
									<kbd class="cap">K</kbd>
								</span>
								<span>Play / pause</span>
							</li>
							<li data-row="1">
								<span class="keycaps">
									<kbd class="cap">←</kbd>
									<kbd class="cap">→</kbd>
								</span>
								<span>Seek one second</span>
							</li>
							<li data-row="2">
								<span class="keycaps">
									<kbd class="cap">J</kbd>
									<kbd class="cap">L</kbd>
								</span>
								<span>Seek ten seconds</span>
							</li>
							<li data-row="3">
								<span class="keycaps">
									<kbd class="cap cap--wide">⇧ Shift</kbd>
									<i>+</i>
									<kbd class="cap">←</kbd>
									<kbd class="cap">→</kbd>
								</span>
								<span>Step one frame</span>
							</li>
							<li data-row="4">
								<span class="keycaps">
									<kbd class="cap">[</kbd>
									<kbd class="cap">]</kbd>
								</span>
								<span>Set selection start / end at the playhead</span>
							</li>
						</ul>
						<p class="try-note">
							Shortcuts pause while you're editing an input, using a dialog, or
							exporting.
						</p>
					</div>
					<div
						class="try__player product-surface workbench light"
						data-try
						tabindex="-1"
					>
						<p class="enhancement-note">
							Static demo. Interactive controls require JavaScript.
						</p>
						<div class="try__time mono">
							<output data-out="timecode">00:00:00.000</output>
						</div>
						<Fragment set:html={timelineHTML({ ruler: false, video: false })} />
						<div class="try__foot">
							<button
								class="t-btn t-btn--play"
								type="button"
								disabled
								data-play
								aria-label="Play"
							>
								<svg class="i-play" viewBox="0 0 16 16" aria-hidden="true">
									<path d="M5 3.5v9l7-4.5z" fill="currentColor" />
								</svg>
								<svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true">
									<path
										d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z"
										fill="currentColor"
									/>
								</svg>
							</button>
							<button
								class="t-btn"
								type="button"
								disabled
								data-loop
								aria-pressed="false"
								aria-label="Loop selection"
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										d="M3 7V6a2 2 0 0 1 2-2h7l-2-2M13 9v1a2 2 0 0 1-2 2H4l2 2"
										fill="none"
										stroke="currentColor"
										stroke-width="1.4"
									/>
								</svg>
							</button>
							<span class="mono try__range">
								Selection{" "}
								<output data-out="start" data-short>
									00:00.000
								</output>{" "}
								–{" "}
								<output data-out="end" data-short>
									01:33.525
								</output>
							</span>
							<span class="try__hint" data-hint></span>
						</div>
					</div>
				</div>
			</details>
		</div>
	</section>

	<!-- ───────────────────────────── Limits ───────────────────────────── -->
	<section class="section" id="limits" tabindex="-1" data-scroll-target>
		<div class="container limits-grid">
			<div>
				<h2 class="limits__heading" data-reveal>
					Limitations
				</h2>
				<ul class="limits">
					<li>
						<b>Chromium comes first</b>
						<span>Needs WebCodecs support, such as Chrome or Edge.</span>
					</li>
					<li>
						<b>Export boundaries are best effort</b>
						<span>
							Exported start and end frames may not land exactly on the
							selection.
						</span>
					</li>
					<li>
						<b>Large exports need memory</b>
						<span>YAFFW buffers the output in memory before download.</span>
					</li>
				</ul>
			</div>
			<div id="planned" tabindex="-1" data-scroll-target>
				<h2 class="limits__heading" data-reveal>
					Planned
				</h2>
				<ul class="limits">
					<li>
						<b>Multiple videos and audio-only files</b>
						<span>Today YAFFW opens one video at a time.</span>
					</li>
					<li>
						<b>Saving your edit across refreshes</b>
						<span>
							Today a refresh clears the loaded video, selection and export
							result. YAFFW already remembers layout and presets.
						</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- ───────────────────────────── Source ───────────────────────────── -->
	<section class="section" id="source" tabindex="-1" data-scroll-target>
		<div class="container source">
			<div>
				<h2 class="section__title" data-reveal>
					Run it locally
					<span class="muted">
						You need Node.js 24.16+ (or 26.3+) and pnpm 10.33.0. There are no
						API keys, environment variables or backend services to set up.
					</span>
				</h2>
				<a class="btn btn--ghost" href={REPO_URL}>
					DarkZeus/yaffw on GitHub →
				</a>
			</div>
			<article class="repo" data-repo>
				<header class="repo__head">
					<Image
						src={brandIcon}
						alt=""
						width={20}
						height={20}
						densities={[1, 2, 3]}
						format="webp"
						loading="lazy"
					/>
					<a href={REPO_URL}>
						<span class="dim">DarkZeus /</span> <b>yaffw</b>
					</a>
				</header>
				<p class="repo__desc">
					A video editor that runs in your browser, built around my own editing
					workflow.
				</p>
				<div class="repo__tabs" hidden role="tablist" aria-label="Commands">
					<button
						id="commands-run-tab"
						role="tab"
						aria-controls="commands-run-panel"
						aria-selected="true"
						tabindex="0"
						data-tab="0"
					>
						Run
					</button>
					<button
						id="commands-develop-tab"
						role="tab"
						aria-controls="commands-develop-panel"
						aria-selected="false"
						tabindex="-1"
						data-tab="1"
					>
						Develop
					</button>
				</div>
				<pre
					id="commands-run-panel"
					class="repo__term mono"
					role="tabpanel"
					aria-labelledby="commands-run-tab"
					data-pane="0"
					tabindex="0"
				><code data-command>{`git clone ${REPO_URL}.git
cd yaffw
pnpm install --frozen-lockfile
pnpm dev`}</code>
<span class="t-o">  ➜  Local:   </span><span class="t-a">http://localhost:3000/</span></pre>
				<div
					id="commands-develop-panel"
					role="tabpanel"
					aria-labelledby="commands-develop-tab"
					tabindex="0"
					data-pane="1"
					hidden
				>
					<dl class="repo__dev mono">
						<div>
							<dt>pnpm verify</dt>
							<dd>Format, lint, test, build and type check</dd>
						</div>
						<div>
							<dt>pnpm test</dt>
							<dd>Run the test suite</dd>
						</div>
						<div>
							<dt>pnpm typecheck</dt>
							<dd>Check types with TypeScript 7</dd>
						</div>
						<div>
							<dt>pnpm run build</dt>
							<dd>Build to dist</dd>
						</div>
					</dl>
				</div>
				<button class="copy-btn repo__copy" type="button" hidden data-copy>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<rect
							x="5"
							y="5"
							width="8.5"
							height="8.5"
							rx="1.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
						/>
						<path
							d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
						/>
					</svg>
					<span data-label>Copy</span>
				</button>
				<p class="repo__feedback" role="status" data-copy-status></p>
			</article>
			<div class="source__credits">
				<h3>Built with</h3>
				<p>
					Thanks to the open-source projects and browser media APIs that make
					local editing possible.
				</p>
				<dl class="source__technologies">
					<div>
						<dt>Browser APIs</dt>
						<dd>
							<a href="https://developer.mozilla.org/en-US/docs/Web/API/WebCodecs_API">
								WebCodecs
							</a>
							<a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API">
								Web Audio
							</a>
						</dd>
					</div>
					<div>
						<dt>Libraries and frameworks</dt>
						<dd>
							<a href="https://mediabunny.dev/">Mediabunny</a>
							<a href="https://wavesurfer.xyz/">wavesurfer.js</a>
							<a href="https://react.dev/">React</a>
							<a href="https://tailwindcss.com/">Tailwind CSS</a>
							<a href="https://ui.shadcn.com/">shadcn/ui</a>
						</dd>
					</div>
					<div>
						<dt>Editor tooling</dt>
						<dd>
							<a href="https://www.typescriptlang.org/">TypeScript</a>
							<a href="https://vite.dev/">Vite</a>
						</dd>
					</div>
					<div>
						<dt>Landing site</dt>
						<dd>
							<a href="https://astro.build/">Astro</a>
						</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	<section class="cta container">
		<div>
			<p class="chapter-label">YAFFW</p>
			<h2>
				Open a video.
				<br />
				Make your edit.
			</h2>
		</div>
		<div class="cta__actions">
			<a class="btn btn--primary btn--lg" href={EDITOR_URL}>
				Open the editor <span aria-hidden="true">↗</span>
			</a>
			<a class="text-link" href={`${REPO_URL}#readme`}>
				Read the README
			</a>
		</div>
	</section>
</Base>

<script>
	import "../scripts/main.js";
</script>
